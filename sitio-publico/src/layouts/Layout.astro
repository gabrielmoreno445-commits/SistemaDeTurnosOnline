---
// layouts/Layout.astro
// Layout base del sitio publico. Lo usan todas las paginas .astro.
// Importa el sistema de diseno CSS y define la estructura comun del HTML.
// Tambien centraliza el navbar para mantener links y estado activo consistentes.

import '../styles/global.css';

const { title = 'Sistema de Turnos Online' } = Astro.props;
const pathname = Astro.url.pathname;
const esActivo = (href) => pathname === href || (href !== '/' && pathname.startsWith(href));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- TODO (Producción): reinstalar una fuente externa solo si se sirve desde un CDN aprobado
         o si la tipografía queda alojada localmente dentro del proyecto. -->
    <title>{title}</title>
    <script is:inline>
      try {
        const tema = localStorage.getItem('tema') || 'light';
        document.documentElement.setAttribute('data-theme', tema);
      } catch {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="shell">
        <a href="/" class="brand">Sistema de Turnos Online</a>
        <nav class="site-nav" aria-label="Navegacion principal">
          <a href="/" class:list={['nav-link', { active: esActivo('/') }]}>Inicio</a>
          <a href="/tu-necesidad" class:list={['nav-link', { active: esActivo('/tu-necesidad') }]}>
            Tu necesidad
          </a>
          <a href="http://localhost:5173/register" class="nav-link">Registrarse como profesional</a>
        </nav>
        <button id="theme-toggle" class="theme-toggle btn" type="button">🌙</button>
      </div>
    </header>

    <main class="site-main">
      <div class="shell">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="shell">
        <p>Reservas simples para profesionales independientes.</p>
      </div>
    </footer>
    <script is:inline>
      const actualizarTextoTema = (btn, temaActual) => {
        btn.textContent = temaActual === 'dark' ? '☀️' : '🌙';
      };

      document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('theme-toggle');

        if (!btn) {
          return;
        }

        actualizarTextoTema(btn, document.documentElement.getAttribute('data-theme') || 'light');

        btn.addEventListener('click', () => {
          const actual = document.documentElement.getAttribute('data-theme');
          const nuevo = actual === 'dark' ? 'light' : 'dark';

          document.documentElement.setAttribute('data-theme', nuevo);

          try {
            localStorage.setItem('tema', nuevo);
          } catch {
            // TODO (Producción): persistir el tema en una capa de configuración segura si
            // el navegador bloquea storage local.
          }

          actualizarTextoTema(btn, nuevo);
        });
      });
    </script>
  </body>
</html>

<style>
  .shell {
    width: min(100% - 32px, 1100px);
    margin: 0 auto;
  }

  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg-card);
  }

  .site-header .shell {
    min-height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    display: inline-block;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-left: auto;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-weight: 600;
    transition:
      background-color var(--transition),
      color var(--transition);
  }

  .nav-link:hover,
  .nav-link.active {
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  .site-main {
    padding: 40px 0 56px;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-secondary);
  }

  .site-footer .shell {
    padding: 20px 0;
  }

  .theme-toggle {
    min-width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-base);
    color: var(--text-primary);
    font-size: 1rem;
    line-height: 1;
  }

  @media (max-width: 760px) {
    .site-header .shell {
      flex-wrap: wrap;
      padding: 14px 0;
    }

    .brand {
      flex: 1 1 calc(100% - 60px);
    }

    .site-nav {
      order: 3;
      width: 100%;
      justify-content: flex-start;
      overflow-x: auto;
    }

    .nav-link {
      white-space: nowrap;
    }
  }
</style>
