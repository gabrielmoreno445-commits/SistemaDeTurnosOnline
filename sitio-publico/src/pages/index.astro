---
// pages/index.astro
// Landing principal del sitio publico.
// Presenta la propuesta de valor y el flujo basico de reserva sin logica activa.

import Layout from '../layouts/Layout.astro';
---

<Layout title="Reserva tu turno online">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Sitio publico</p>
      <h1>Reserva tu turno online</h1>
      <p class="lead">
        Encontra profesionales y agenda en segundos, sin llamadas ni mensajes.
      </p>
    </div>

    <form class="search-card">
      <label class="search-label" for="busqueda">Busca tu proximo turno</label>
      <div class="search-row">
        <input
          id="busqueda"
          type="text"
          placeholder="Busca por nombre o especialidad..."
        />
        <button type="button">Buscar</button>
      </div>
    </form>
  </section>

  <section class="como-funciona">
    <article class="step-card card animate-in" style="animation-delay: 60ms;">
      <span class="step-number">1</span>
      <h2>Elegi tu profesional</h2>
      <p>Explora perfiles publicos y encontra la especialidad que necesitas.</p>
    </article>

    <article class="step-card card animate-in" style="animation-delay: 120ms;">
      <span class="step-number">2</span>
      <h2>Selecciona fecha y horario</h2>
      <p>Revisa la disponibilidad real y elige el mejor momento para vos.</p>
    </article>

    <article class="step-card card animate-in" style="animation-delay: 180ms;">
      <span class="step-number">3</span>
      <h2>Confirma tu turno</h2>
      <p>Completa tus datos y deja la reserva registrada en pocos segundos.</p>
    </article>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    gap: 24px;
    align-items: start;
    margin-bottom: 40px;
  }

  .eyebrow {
    margin-bottom: 8px;
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.05;
    margin-bottom: 16px;
  }

  .lead {
    max-width: 640px;
    color: var(--text-secondary);
    font-size: 1.05rem;
  }

  .search-card {
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    box-shadow: var(--shadow-sm);
  }

  .search-label {
    display: block;
    margin-bottom: 12px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .search-row {
    display: grid;
    gap: 12px;
  }

  .search-row input {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-input);
    color: var(--text-primary);
  }

  .search-row input:focus {
    outline: 2px solid transparent;
    border-color: var(--border-focus);
  }

  .search-row button {
    border: none;
    border-radius: var(--radius-md);
    padding: 14px 18px;
    background: var(--color-primary);
    color: var(--text-on-primary);
    font-weight: 600;
    cursor: pointer;
    transition: background var(--transition);
  }

  .search-row button:hover {
    background: var(--color-primary-hover);
  }

  .como-funciona {
    display: grid;
    gap: 16px;
  }

  .step-card {
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    box-shadow: var(--shadow-sm);
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    margin-bottom: 16px;
    border-radius: 999px;
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-weight: 700;
  }

  .step-card h2 {
    margin-bottom: 10px;
    font-size: 1.1rem;
  }

  .step-card p {
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: 1.3fr 0.9fr;
      margin-bottom: 56px;
    }

    .como-funciona {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .search-row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media (max-width: 700px) {
    .como-funciona {
      grid-template-columns: 1fr;
    }
  }
</style>
