---
// pages/[slug].astro
// Pagina publica de cada profesional. La ruta dinamica [slug] permite
// que cada profesional tenga su propia URL: tudominio.com/maria-garcia
//
// Flujo de esta primera version:
// 1. Astro obtiene el slug desde la URL
// 2. Consulta el backend desde el servidor usando el nombre del servicio Docker
// 3. Si el slug no existe o la API falla, redirige a 404
// 4. Renderiza nombre y especialidad en HTML estatico

import Layout from '../layouts/Layout.astro';
import FormReserva from '../vue-components/FormReserva.vue';

export const prerender = false;

const { slug } = Astro.params;

let profesional = null;

try {
  const res = await fetch(`http://backend:4000/publico/${slug}`);

  if (!res.ok) {
    return Astro.redirect('/404');
  }

  profesional = await res.json();
} catch (error) {
  return Astro.redirect('/404');
}
---

<Layout title={`${profesional.nombre} | Sistema de Turnos Online`}>
  <section class="pagina-profesional">
    <div class="profile-card card animate-in">
    <p class="eyebrow">Perfil publico</p>
    <h1>{profesional.nombre}</h1>
    <p class="specialty">{profesional.especialidad || 'Especialidad no informada'}</p>
    {profesional.descripcion && (
      <p class="profesional-descripcion">{profesional.descripcion}</p>
    )}
    {profesional.direccion && (
      <p class="profesional-direccion">📍 {profesional.direccion}</p>
    )}
    <hr />
    <FormReserva client:load slug={slug} />
    </div>
  </section>
</Layout>

<style>
  .pagina-profesional {
    max-width: 680px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .profile-card {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    box-shadow: var(--shadow-sm);
  }

  .eyebrow {
    margin-bottom: 10px;
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    margin-bottom: 10px;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.05;
  }

  .specialty {
    margin-bottom: 14px;
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .profesional-descripcion,
  .profesional-direccion {
    margin: 0 0 10px;
    color: var(--text-secondary);
  }

  .profesional-direccion {
    font-weight: 600;
    color: var(--text-primary);
  }

  hr {
    border: none;
    border-top: 1px solid var(--border);
    margin-bottom: 20px;
  }
</style>
