---
// pages/[slug].astro
// Pagina publica de cada profesional. La ruta dinamica [slug] permite
// que cada profesional tenga su propia URL: tudominio.com/maria-garcia.
//
// Astro consulta el backend desde el servidor usando el nombre del servicio Docker.
// Si el slug no existe o la API falla, redirige a 404 para no mostrar una ficha incompleta.
// Renderiza una carta de presentacion estatica y monta FormReserva como isla Vue.

import Layout from '../layouts/Layout.astro';
import FormReserva from '../vue-components/FormReserva.vue';

export const prerender = false;

const { slug } = Astro.params;
const API_URL = import.meta.env.API_URL || 'http://backend:4000';
const PUBLIC_API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:4000';

let profesional = null;

try {
  const res = await fetch(`${API_URL}/publico/${slug}`);

  if (!res.ok) {
    return Astro.redirect('/404');
  }

  profesional = await res.json();
} catch (error) {
  return Astro.redirect('/404');
}
---

<Layout title={`${profesional.nombre} | Sistema de Turnos Online`}>
  <section class="pagina-profesional">
    <div class="profile-card card animate-in">
      <div class="profesional-header">
        {profesional.foto_url && (
          <img
            src={`${PUBLIC_API_URL}${profesional.foto_url}`}
            alt={`Foto de ${profesional.nombre}`}
            class="foto-perfil"
          />
        )}

        <div class="profesional-info">
          <p class="eyebrow">Perfil publico</p>
          <h1 class="profesional-nombre">{profesional.nombre}</h1>
          <p class="profesional-especialidad">
            {profesional.especialidad || 'Especialidad no informada'}
          </p>

          {profesional.descripcion && (
            <p class="profesional-descripcion">{profesional.descripcion}</p>
          )}

          {profesional.direccion && (
            <p class="profesional-direccion">
              <span class="icono">Ubicacion:</span> {profesional.direccion}
            </p>
          )}

          {profesional.zona_cobertura && (
            <p class="profesional-direccion">
              <span class="icono">Zona:</span> {profesional.zona_cobertura}
            </p>
          )}
        </div>
      </div>

      <hr />
      <FormReserva client:load slug={slug} />
    </div>
  </section>
</Layout>

<style>
  .pagina-profesional {
    max-width: 680px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .profile-card {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    box-shadow: var(--shadow-sm);
  }

  .profesional-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 1rem;
    gap: 1rem;
  }

  .foto-perfil {
    width: 100px;
    height: 100px;
    display: block;
    margin: 0 auto 1rem;
    border: 3px solid var(--border);
    border-radius: 50%;
    object-fit: cover;
  }

  .profesional-info {
    display: grid;
    justify-items: center;
    gap: 10px;
  }

  .eyebrow {
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .profesional-nombre {
    color: var(--text-primary);
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .profesional-especialidad {
    color: var(--color-primary);
    font-size: 1rem;
    font-weight: 600;
  }

  .profesional-descripcion {
    max-width: 500px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .profesional-direccion {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .icono {
    font-weight: 700;
  }

  hr {
    border: none;
    border-top: 1px solid var(--border);
    margin-bottom: 20px;
  }
</style>
