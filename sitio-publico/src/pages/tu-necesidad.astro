---
// pages/tu-necesidad.astro
// Reubica la experiencia de busqueda y explicacion del flujo para liberar el inicio.
// Depende de Layout.astro para la estructura comun y de BuscadorProfesional.vue para la busqueda reactiva.

import Layout from '../layouts/Layout.astro';
import BuscadorProfesional from '../vue-components/BuscadorProfesional.vue';

const demoMode = Astro.url.searchParams.get('demo') === '1';
---

<Layout title="Tu necesidad">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Sitio publico</p>
      <h1>Reserva tu turno online</h1>
      <p class="lead">
        Encontra profesionales de Eldorado, Misiones y alrededores. Agenda en segundos, sin llamadas ni mensajes.
      </p>
    </div>

    <BuscadorProfesional client:load demoMode={demoMode} />
  </section>

  <section class="como-funciona">
    <article class="step-card card animate-in" style="animation-delay: 60ms;">
      <span class="step-number">1</span>
      <h2>Elegi tu profesional</h2>
      <p>Explora perfiles publicos, oficios y especialidades disponibles en tu zona.</p>
    </article>

    <article class="step-card card animate-in" style="animation-delay: 120ms;">
      <span class="step-number">2</span>
      <h2>Selecciona fecha y horario</h2>
      <p>Revisa la disponibilidad real y elige si vas al local o si el profesional va a tu domicilio.</p>
    </article>

    <article class="step-card card animate-in" style="animation-delay: 180ms;">
      <span class="step-number">3</span>
      <h2>Confirma tu turno</h2>
      <p>Completa tus datos y deja la reserva registrada en pocos segundos.</p>
    </article>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    gap: 24px;
    align-items: start;
    margin-bottom: 40px;
  }

  .eyebrow {
    margin-bottom: 8px;
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.05;
    margin-bottom: 16px;
  }

  .lead {
    max-width: 640px;
    color: var(--text-secondary);
    font-size: 1.05rem;
  }

  .como-funciona {
    display: grid;
    gap: 16px;
  }

  .step-card {
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    box-shadow: var(--shadow-sm);
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    margin-bottom: 16px;
    border-radius: 999px;
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-weight: 700;
  }

  .step-card h2 {
    margin-bottom: 10px;
    font-size: 1.1rem;
  }

  .step-card p {
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: 1.3fr 0.9fr;
      margin-bottom: 56px;
    }

    .como-funciona {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .como-funciona {
      grid-template-columns: 1fr;
    }
  }
</style>
