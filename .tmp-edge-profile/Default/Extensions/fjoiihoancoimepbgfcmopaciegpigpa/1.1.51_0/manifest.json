{
   "action": {
      "default_icon": "assets/icon/eva128.png",
      "default_popup": "popup.html",
      "default_title": "Speak Subtitles for YouTube"
   },
   "author": "VitalisAulon",
   "background": {
      "service_worker": "sw.bundle.hdh2cnbfpdin.js"
   },
   "content_scripts": [ {
      "js": [ "content.bundle.hdh2cnbfpdin.js", "webpage.bundle.hdh2cnbfpdin.js", "ga.bundle.hdh2cnbfpdin.js" ],
      "matches": [ "https://www.youtube.com/*" ],
      "run_at": "document_idle",
      "world": "MAIN"
   } ],
   "default_locale": "en",
   "description": "__MSG_extension_description__",
   "externally_connectable": {
      "matches": [ "https://www.youtube.com/*" ]
   },
   "host_permissions": [ "https://www.youtube.com/*" ],
   "icons": {
      "128": "assets/icon/eva128.png",
      "512": "assets/icon/eva512.png"
   },
   "key": "",
   "manifest_version": 3,
   "minimum_chrome_version": "88.0",
   "name": "__MSG_extension_name__",
   "options_page": "don.html",
   "options_ui": {
      "open_in_tab": true,
      "page": "don.html"
   },
   "permissions": [ "storage", "webRequest" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.1.51"
}
